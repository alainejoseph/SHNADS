# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_home_anomaly

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS - comma separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Capture Configuration
# Comma-separated list of allowed interfaces (empty = allow all available)
CAPTURE_INTERFACES_ALLOWED=

# Discovery Configuration
# Subnet for ARP discovery (e.g., 192.168.1.0/24)
# If empty, will try to detect from the selected interface
DISCOVERY_SUBNET=

